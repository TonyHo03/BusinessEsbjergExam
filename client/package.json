{
  "name": "bun-react-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "build": "bun build ./src/index.html --outdir=dist --sourcemap --target=browser --minify --define:process.env.NODE_ENV='\"production\"' --env='BUN_PUBLIC_*'",
    "generate-api": "swagger-typescript-api generate -p http://localhost:5265/swagger/v1/swagger.json -o src/api -n Api.ts",
    "start": "NODE_ENV=production bun src/index.ts",
    "typecheck": "bun check"
  },
  "dependencies": {
    "bun-plugin-tailwind": "^0.1.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.72.0",
    "react": "^19",
    "react-dom": "^19",
    "react-router": "^8.5.1",
    "react-router-dom": "^7.18.5",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "swagger-typescript-api": "^13.14.0"
  },
  "peerDependencies": {
    "typescript": "^7"
  }
}
